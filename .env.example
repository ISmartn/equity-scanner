# UPSTOX_ACCESS_TOKEN=your_upstox_oauth_access_token
# UPSTOX_SANDBOX=false
# BACKEND_PORT=8000

# Multi-timeframe RSI service (cd backend && python -m mtf_rsi)
# RSI_PERIOD=14
# TIMEFRAMES=1,3,5,10,15
# UPSTOX_INSTRUMENT_KEY=NSE_INDEX|Nifty 50
# MTF_RSI_CACHE_DIR=data/mtf_rsi_cache

# Local SQLite path for timeline / daily movers (default: data/trading.db)
# TIMELINE_DB_PATH=/absolute/path/to/trading/data/trading.db

# Forecast model: timesfm-2.5 (default) | timesfm-fin
# FORECAST_MODEL=timesfm-2.5

# TimesFM-Fin subprocess (Python 3.10 venv — run timesfm_fin/setup.sh first)
# TIMESFM_FIN_PYTHON=/absolute/path/to/trading/timesfm_fin/.venv/bin/python
# TIMESFM_FIN_REPO_ID=pfnet/timesfm-1.0-200m-fin
# TIMESFM_FIN_BACKEND=cpu

# Verbose backend + subprocess logs (HF download, checkpoint restore, etc.)
# FORECAST_DEBUG=1

# Telegram news impact (RedboxGlobal India) — https://my.telegram.org
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_PATH=data/telegram_news.session
# TELEGRAM_CHANNELS=@indiaredboxglobal
# Commodity keyword monitors (Gold / Silver / Crude Oil) on channel text
# NEWS_MONITOR_TOPICS=GOLD,SILVER,CRUDEOIL

# Gemini (optional — entity extract + outlook). https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
